{
  "name": "root",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.21.1",
    "turbo": "^2.9.6",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,mts,cts,json,jsonc,css,md,mdx}": "oxfmt --write --no-error-on-unmatched-pattern",
    "*.{ts,tsx}": "oxlint --fix --quiet"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.1"
}
